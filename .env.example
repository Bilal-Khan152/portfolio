# Copy this file to .env.local and fill in the key. .env.local is never committed.
# CallMeBot (free): message the bot on WhatsApp with "I allow callmebot to send me messages" to get your key.
CALLMEBOT_APIKEY=

# Resend (free): sign up at resend.com with the inbox that should receive alerts, create an API key.
RESEND_API_KEY=
